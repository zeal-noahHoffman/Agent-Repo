# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-xxxxx
SLACK_APP_TOKEN=xapp-xxxxx
# Optional: restrict the agent to specific channel IDs (comma-separated). Empty = all.
SLACK_ALLOWED_CHANNELS=C0B73ULTZLZ

# Jira Cloud
JIRA_URL=https://zealitconsultants-agentic-team.atlassian.net
JIRA_EMAIL=noah.hoffman@zealitconsultants.com
JIRA_API_TOKEN=your-jira-api-token
# Board column/status names the agent moves tickets to (must match your board
# exactly). Defaults shown; override if your columns are named differently.
JIRA_STATUS_IN_PROGRESS=In Progress
JIRA_STATUS_IN_REVIEW=In Review
# Intake guardrail: the agent only picks up tickets carrying this label; any
# ticket without it is refused before any work begins. Matched case-insensitively.
# Leave empty to disable the gate (pick up any ticket).
JIRA_REQUIRED_LABEL=Agent-Intake

# GitHub
GITHUB_TOKEN=ghp_xxxxx
GITHUB_REPO=zeal-noahHoffman/Demo-Project

# Agent Config
WORKSPACE_DIR=/workspace
ANTHROPIC_MODEL=claude-sonnet-4-6
AGENT_MAX_TURNS=60
# Hard spend cap per ticket (one agent run), in USD. Not a lifetime cap.
AGENT_MAX_BUDGET_USD=5.0
# Max tickets built concurrently in a batch (independent tickets fan out to this).
AGENT_MAX_CONCURRENCY=3

# Persisted state (pending batch approvals + dashboard logs + cost analytics)
# These live on a persistent volume so they survive a restart/redeploy/OOM — the system
# temp dir is ephemeral on Railway, which silently lost pending batches (an in-thread
# `approve` then read back as "nothing pending"). Mount a Railway volume at DATA_DIR
# (/data) for this. It MUST be a different mount path than WORKSPACE_DIR (/workspace): the
# bot clones the target repo into the workspace and needs it to start empty, so a volume
# can't live there. Off-Railway (no /data) these files fall back to the temp dir.
DATA_DIR=/data
# The overrides below are optional — set them only to relocate the files off DATA_DIR.
# PENDING_BATCH_FILE=/data/agent_pending_batches.json
# AGENT_LOG_FILE=/data/agent_logs.jsonl
# COST_DB_FILE=/data/cost_analytics.db
# How many recent log records the dashboard keeps/serves.
LOG_BUFFER_SIZE=1000
# Most recent agent-run cost events the /api/costs endpoint returns to the dashboard.
COST_EVENTS_LIMIT=5000

# Single-instance guard. The bot MUST run as exactly ONE Slack-connected instance
# (Socket Mode load-balances events across every open connection, and pending batches +
# worktrees live on one instance's disk). The dashboard should be deployed as the static
# frontend/ build (see frontend/README.md) — but if you ever run THIS full image as a
# dashboard-only service, set DASHBOARD_ONLY=1 so it serves the dashboard WITHOUT opening
# a Slack connection (otherwise it becomes a second bot and batch approvals break).
# DASHBOARD_ONLY=1
