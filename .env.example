# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-xxxxx
SLACK_APP_TOKEN=xapp-xxxxx
# Optional: restrict the agent to specific channel IDs (comma-separated). Empty = all.
SLACK_ALLOWED_CHANNELS=C0B73ULTZLZ

# Jira Cloud
JIRA_URL=https://zealitconsultants-agentic-team.atlassian.net
JIRA_EMAIL=noah.hoffman@zealitconsultants.com
JIRA_API_TOKEN=your-jira-api-token
# Board column/status names the agent moves tickets to (must match your board
# exactly). Defaults shown; override if your columns are named differently.
JIRA_STATUS_IN_PROGRESS=In Progress
JIRA_STATUS_IN_REVIEW=In Review

# GitHub
GITHUB_TOKEN=ghp_xxxxx
GITHUB_REPO=zeal-noahHoffman/Demo-Project

# Agent Config
WORKSPACE_DIR=/workspace
ANTHROPIC_MODEL=claude-sonnet-4-6
AGENT_MAX_TURNS=60
# Hard spend cap per ticket (one agent run), in USD. Not a lifetime cap.
AGENT_MAX_BUDGET_USD=5.0
# Max tickets built concurrently in a batch (independent tickets fan out to this).
AGENT_MAX_CONCURRENCY=3

# Persisted state (pending batch approvals + dashboard logs)
# Both default to the persistent WORKSPACE_DIR (/workspace) volume so they survive a
# restart/redeploy/OOM — the system temp dir is ephemeral on Railway, which silently lost
# pending batches (an in-thread `approve` then read back as "nothing pending"). These
# overrides are optional; set them only to relocate the files off the volume.
# PENDING_BATCH_FILE=/workspace/agent_pending_batches.json
# AGENT_LOG_FILE=/workspace/agent_logs.jsonl
# How many recent log records the dashboard keeps/serves.
LOG_BUFFER_SIZE=1000
