# --- Local dev only ---
# Base URL the Vite dev server proxies `/api/*` to. Lets you run `npm run dev`
# against a locally-running agent without CORS or hardcoded URLs.
VITE_API_TARGET=http://localhost:8000

# --- Production build (e.g. deploying this folder as its own Railway service) ---
# Public URL of the AGENT service that serves /api/logs. Baked into the build,
# so it must be set at build time. Leave unset for same-origin (when the agent
# itself serves this dashboard). Example:
# VITE_API_BASE=https://your-agent.up.railway.app
